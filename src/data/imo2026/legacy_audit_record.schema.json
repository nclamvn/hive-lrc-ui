{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HIVE-IMO Legacy Manuscript Audit Record",
  "type": "object",
  "required": [
    "problem_id",
    "manuscript",
    "official_binding",
    "exposure",
    "proof_obligations",
    "audit_status"
  ],
  "properties": {
    "problem_id": {
      "type": "string",
      "pattern": "^IMO2026-P[1-6]$"
    },
    "manuscript": {
      "type": "object",
      "required": [
        "filename",
        "sha256",
        "provenance_status"
      ],
      "properties": {
        "filename": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "original_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance_status": {
          "enum": [
            "DOCUMENTED",
            "PARTIAL",
            "UNKNOWN"
          ]
        },
        "claimed_authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "official_binding": {
      "type": "object",
      "required": [
        "source_sha256",
        "statement_match"
      ],
      "properties": {
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "statement_match": {
          "enum": [
            "PENDING",
            "MATCH",
            "MISMATCH"
          ]
        }
      }
    },
    "exposure": {
      "type": "object",
      "required": [
        "human",
        "sol",
        "fable"
      ],
      "additionalProperties": {
        "type": "object",
        "properties": {
          "official_solution_exposure": {
            "enum": [
              true,
              false,
              "UNKNOWN"
            ]
          },
          "unofficial_external_solution_exposure": {
            "enum": [
              true,
              false,
              "UNKNOWN"
            ]
          },
          "internal_project_solution_exposure": {
            "enum": [
              true,
              false,
              "UNKNOWN"
            ]
          },
          "search_history_exposure": {
            "enum": [
              true,
              false,
              "UNKNOWN"
            ]
          },
          "blind_reconstruction_eligible": {
            "enum": [
              true,
              false,
              "UNKNOWN"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "proof_obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "status",
          "dependencies"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "status": {
            "enum": [
              "UNPARSED",
              "CLAIMED",
              "LOCALLY-CHECKED",
              "COUNTEREXAMPLE-FOUND",
              "NEEDS-REPAIR",
              "VERIFIED-BY-INDEPENDENT-AUDITOR",
              "FORMALIZED"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "load_bearing": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "audit_status": {
      "enum": [
        "NOT-STARTED",
        "RECONCILED",
        "AUDIT-IN-PROGRESS",
        "VERIFIED-INDEPENDENT",
        "ACCEPT-WITH-REPAIRS",
        "REFUTED",
        "OPEN"
      ]
    }
  }
}